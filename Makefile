# PHI Guard — local, free-to-run HIPAA compliance-as-code + PHI leak detection demo.
# `make help` lists targets. Everything runs on a laptop (kind); nothing touches a cloud account.

SHELL          := /bin/bash
.SHELLFLAGS    := -eu -o pipefail -c
CLUSTER        := phi-guard
PYTHON         ?= $(shell command -v python3.11 2>/dev/null || command -v python3 2>/dev/null)
VENV           := .venv
PY             := $(VENV)/bin/python
APP_IMAGE      := phi-guard/sample-ehr:0.1.0
SCANNER_IMAGE  := phi-guard/phi-scanner:0.1.0
FALCO_DRIVER   ?= modern_ebpf
DATA_SOURCE    ?= python
PATIENTS       ?= 200
NETPOL         ?= true
SYNTHEA_JAR    := build/synthea/synthea-with-dependencies.jar

.DEFAULT_GOAL := help
.PHONY: help check-tools venv data synthea-data cluster ingress build tls deploy up render leak-on leak-off \
        traffic logs plan report report-strict tf-kind-plan scanner-build detector-up falco-up seed seed-offline \
        measure-detect measure-offline demo-offline triage review-eval measure docs test demo down clean

help: ## list targets
	@grep -hE '^[a-zA-Z_-]+:.*?## ' $(MAKEFILE_LIST) | awk 'BEGIN{FS=":.*?## "}{printf "  \033[36m%-16s\033[0m %s\n", $$1, $$2}'

check-tools: ## verify required CLIs are installed
	@for t in docker kind kubectl helm terraform $(PYTHON) conftest checkov openssl; do \
	  if command -v $$t >/dev/null 2>&1; then printf "  ok      %s\n" $$t; else printf "  MISSING %s\n" $$t; fi; done
	@docker info >/dev/null 2>&1 && echo "  ok      docker daemon running" || echo "  MISSING docker daemon (start Docker Desktop / dockerd)"

$(PY): requirements-dev.txt
	@test -n "$(PYTHON)" || { echo "Python 3.11+ not found. Install it, or run: make PYTHON=/path/to/python3.11 <target>"; exit 1; }
	@$(PYTHON) -c 'import sys; sys.exit(0 if sys.version_info >= (3, 11) else "Python 3.11+ required (found " + sys.version.split()[0] + "); pass PYTHON=/path/to/python3.11")'
	$(PYTHON) -m venv $(VENV)
	$(PY) -m pip install -q --upgrade pip
	$(PY) -m pip install -q -r requirements-dev.txt
	@touch $(PY)

venv: $(PY) ## create .venv with dev dependencies

# ------------------------------------------------------------------ Phase 1: data, cluster, app
data: $(PY) ## generate ~200 synthetic patients (DATA_SOURCE=python|synthea)
ifeq ($(DATA_SOURCE),synthea)
	$(MAKE) synthea-data
else
	$(PY) scripts/generate_patients.py --count $(PATIENTS) --seed 42 --out app/sample-ehr/data/patients.json
endif

synthea-data: $(PY) ## generate patients with Synthea (needs Java 17)
	@mkdir -p build/synthea
	@test -f $(SYNTHEA_JAR) || curl -fsSL -o $(SYNTHEA_JAR) \
	  https://github.com/synthetichealth/synthea/releases/download/master-branch-latest/synthea-with-dependencies.jar
	java -jar $(SYNTHEA_JAR) -p $(PATIENTS) -s 42 --exporter.csv.export=true --exporter.fhir.export=false \
	  --exporter.baseDirectory=build/synthea/output Massachusetts
	$(PY) scripts/synthea_import.py --csv-dir build/synthea/output/csv --limit $(PATIENTS) --out app/sample-ehr/data/patients.json

cluster: ## create the kind cluster (idempotent)
	@kind get clusters 2>/dev/null | grep -qx $(CLUSTER) || kind create cluster --config infra/kind/cluster.yaml
	kubectl config use-context kind-$(CLUSTER)
	kubectl apply -f infra/k8s/namespaces.yaml

ingress: ## install Traefik ingress controller
	helm repo add traefik https://traefik.github.io/charts >/dev/null 2>&1 || true
	helm repo update traefik >/dev/null
	helm upgrade --install traefik traefik/traefik -n traefik --create-namespace \
	  -f infra/helm/traefik-values.yaml --wait --timeout 5m

build: ## build the sample EHR image and load it into kind
	@test -f app/sample-ehr/data/patients.json || $(MAKE) data
	docker build -t $(APP_IMAGE) app/sample-ehr
	kind load docker-image $(APP_IMAGE) --name $(CLUSTER)

tls: ## create a self-signed TLS secret for https://localhost
	@mkdir -p build/tls
	@test -f build/tls/tls.crt || openssl req -x509 -nodes -newkey rsa:2048 -days 365 \
	  -keyout build/tls/tls.key -out build/tls/tls.crt -subj "/CN=localhost"
	kubectl -n phi create secret tls phi-guard-tls --cert=build/tls/tls.crt --key=build/tls/tls.key \
	  --dry-run=client -o yaml | kubectl apply -f -

deploy: ## install/upgrade the sample EHR Helm chart
	helm upgrade --install sample-ehr infra/helm/sample-ehr -n phi --set networkPolicy.enabled=$(NETPOL) \
	  --wait --timeout 3m
	kubectl -n phi get pods -o wide

up: data cluster ingress build tls deploy ## Phase 1: cluster + app, end to end
	@echo; echo "App is up:  curl -k https://localhost/patients/1"

render: ## render the Helm chart into infra/k8s/rendered/ (scanned by policies)
	@{ echo "# Generated by \`make render\` (helm template infra/helm/sample-ehr -n phi). Do not edit by hand."; \
	   helm template sample-ehr infra/helm/sample-ehr --namespace phi; } > infra/k8s/rendered/sample-ehr.yaml

leak-on: ## make the services log PHI (LEAK_MODE=on)
	helm upgrade sample-ehr infra/helm/sample-ehr -n phi --reuse-values --set leakMode=on --wait

leak-off: ## back to compliant logging
	helm upgrade sample-ehr infra/helm/sample-ehr -n phi --reuse-values --set leakMode=off --wait

traffic: $(PY) ## send 60 requests across the three services
	cd app/sample-ehr && ../../$(PY) -m ehr.traffic --base https://localhost --insecure --requests 60

logs: ## tail the app logs
	kubectl -n phi logs -l app.kubernetes.io/part-of=sample-ehr --tail=20 --prefix

# ------------------------------------------------------------------ Phase 2-3: compliance-as-code
plan: ## terraform init + plan (mock creds, no apply) -> build/tfplan.json
	@mkdir -p build
	cd infra/terraform/aws && terraform init -input=false >/dev/null && terraform validate \
	  && terraform plan -input=false -lock=false -refresh=false -out=tfplan.bin >/dev/null \
	  && terraform show -json tfplan.bin > ../../../build/tfplan.json
	@echo "plan -> build/tfplan.json"

report: $(PY) plan render ## run Conftest + Checkov, write evidence/compliance-report.{json,md,html}
	$(PY) scripts/report.py --fail-on HIGH

report-strict: $(PY) plan render ## same, ignoring waivers (demonstrates the HIGH gate failing)
	-$(PY) scripts/report.py --no-waivers --fail-on HIGH

tf-kind-plan: ## optional: plan the Kubernetes-provider root against the kind cluster
	cd infra/terraform/kind && terraform init -input=false >/dev/null && terraform plan -input=false

# ------------------------------------------------------------------ Phase 4: runtime detection
scanner-build: ## build the Presidio scanner image and load it into kind
	docker build -f detector/presidio/Dockerfile -t $(SCANNER_IMAGE) .
	kind load docker-image $(SCANNER_IMAGE) --name $(CLUSTER)

detector-up: scanner-build ## deploy Presidio scanner, Fluent Bit and Falco
	kubectl apply -f detector/k8s/phi-scanner.yaml
	kubectl -n logging rollout status deploy/phi-scanner --timeout=5m
	helm repo add fluent https://fluent.github.io/helm-charts >/dev/null 2>&1 || true
	helm repo update fluent >/dev/null
	helm upgrade --install fluent-bit fluent/fluent-bit -n logging -f detector/fluent-bit/values.yaml --wait --timeout 5m
	@$(MAKE) --no-print-directory falco-up || echo ">> Falco did not become ready (eBPF driver / host kernel). Log scanning still works; \
	the 10 runtime events will be reported as 'not evaluated'. Try: make falco-up FALCO_DRIVER=ebpf, or a Linux/WSL2 host."

falco-up: ## install Falco with the PHI Guard rules (FALCO_DRIVER=modern_ebpf|ebpf|kmod)
	helm repo add falcosecurity https://falcosecurity.github.io/charts >/dev/null 2>&1 || true
	helm repo update falcosecurity >/dev/null
	helm upgrade --install falco falcosecurity/falco -n falco -f detector/falco/values.yaml \
	  --set driver.kind=$(FALCO_DRIVER) \
	  --set-file 'customRules.phi_guard_rules\.yaml=detector/falco/phi_guard_rules.yaml' --wait --timeout 8m

seed: $(PY) ## inject exactly 50 labelled leaks in-cluster (40 log + 10 runtime) + 30 decoys
	$(PY) scripts/seed_leaks.py --apply

seed-offline: $(PY) ## write the 70 seeded log lines to evidence/seed_lines.log (no cluster)
	$(PY) scripts/seed_leaks.py --local evidence/seed_lines.log

measure-detect: $(PY) ## score in-cluster detection against ground truth
	@echo "waiting 15s for Fluent Bit / Falco to flush..."; sleep 15
	$(PY) scripts/measure.py detect --cluster

measure-offline: $(PY) ## score log-leak detection locally (Presidio if installed, else lite engine)
	$(PY) scripts/measure.py detect --offline

demo-offline: $(PY) ## Python-only demo (no Docker): logs, 50-leak scoring, controls, gate, triage
	$(PY) scripts/demo_offline.py

# ------------------------------------------------------------------ Phase 5: triage
triage: $(PY) ## explain findings (PHI_GUARD_LLM_PROVIDER=mock|anthropic|openai)
	$(PY) -m triage.explain --findings evidence/compliance-report.json --out evidence/triage.json

review-eval: $(PY) ## interactive: time manual vs assisted review of 10 findings
	$(PY) scripts/review_eval.py

# ------------------------------------------------------------------ Phase 6
measure: $(PY) ## compute all results -> evidence/results.{json,md}
	$(PY) scripts/measure.py all

docs: $(PY) ## regenerate docs/control-mapping.md from policies/mapping.yaml
	$(PY) scripts/gen_control_doc.py

test: $(PY) ## unit tests (+ Rego unit tests if conftest is installed)
	@test -f app/sample-ehr/data/patients.json || $(MAKE) data
	$(PY) -m pytest -q
	@if command -v conftest >/dev/null; then \
	  conftest verify --policy policies/rego/terraform && conftest verify --policy policies/rego/kubernetes; \
	else echo "conftest not installed: skipping Rego unit tests"; fi

demo: ## full end-to-end run (continues past the CI gate and an optional Falco failure)
	$(MAKE) --no-print-directory up
	$(MAKE) --no-print-directory report || echo ">> compliance gate reported unwaived HIGH findings (see evidence/); continuing the demo"
	$(MAKE) --no-print-directory detector-up
	$(MAKE) --no-print-directory leak-on traffic seed measure-detect triage measure
	@echo; echo "Demo complete. Open: evidence/compliance-report.html, evidence/triage.md, evidence/results.md"

down: ## delete the kind cluster
	kind delete cluster --name $(CLUSTER)

clean: ## remove generated files (keeps evidence/samples)
	rm -rf build infra/terraform/aws/.terraform infra/terraform/aws/tfplan.bin evidence/offline
	find evidence -maxdepth 1 -type f ! -name '.gitkeep' -delete
